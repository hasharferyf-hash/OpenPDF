{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPDF",
  "version": "0.1.0",
  "identifier": "com.openpdf.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPDF",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "A clean PDF viewer",
    "longDescription": "A lightweight, local-first PDF viewer for Windows."
  }
}